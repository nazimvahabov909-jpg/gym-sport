// ─────────────────────────────────────────────────────────────────────────────
//  United Sport — schema
//  MySQL 8 (MAMP :8889).  Localised content lives in *Translation tables so
//  every locale keeps its own slug, meta tags and body copy.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Category {
  id        Int      @id @default(autoincrement())
  /// Stable machine key (treadmills, strength…) — survives slug/name edits and
  /// keeps the catalogue import idempotent.
  key       String   @unique @db.VarChar(64)
  parentId  Int?
  image     String?  @db.VarChar(512)
  icon      String?  @db.VarChar(512)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  showInMenu Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     ProductCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model CategoryTranslation {
  id              Int     @id @default(autoincrement())
  categoryId      Int
  locale          String  @db.VarChar(5)
  name            String  @db.VarChar(255)
  slug            String  @db.VarChar(255)
  description     String? @db.Text
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.VarChar(500)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(191)
  slug      String   @unique @db.VarChar(191)
  logo      String?  @db.VarChar(512)
  website   String?  @db.VarChar(512)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations BrandTranslation[]
  products     Product[]

  @@index([isActive, sortOrder])
}

model BrandTranslation {
  id              Int     @id @default(autoincrement())
  brandId         Int
  locale          String  @db.VarChar(5)
  description     String? @db.Text
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.VarChar(500)

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, locale])
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String?  @db.VarChar(120)
  brandId     Int?
  price       Decimal  @default(0) @db.Decimal(14, 2)
  oldPrice    Decimal? @db.Decimal(14, 2)
  /// Hide the number and show a "request a price" CTA instead.
  priceOnRequest Boolean @default(false)
  stock       Int      @default(0)
  stockStatus StockStatus @default(IN_STOCK)
  weight      Decimal? @db.Decimal(10, 3)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  isNew       Boolean  @default(false)
  sortOrder   Int      @default(0)
  viewCount   Int      @default(0)
  /// Original OpenCart id — keeps the import idempotent and old URLs mappable.
  legacyId    Int?     @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand        Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  translations ProductTranslation[]
  images       ProductImage[]
  categories   ProductCategory[]
  specs        ProductSpec[]
  reviews      Review[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  wishlisted   WishlistItem[]
  leads        Lead[]

  @@index([isActive, sortOrder])
  @@index([isActive, isFeatured])
  @@index([brandId])
  @@index([createdAt])
}

model ProductTranslation {
  id               Int     @id @default(autoincrement())
  productId        Int
  locale           String  @db.VarChar(5)
  name             String  @db.VarChar(255)
  slug             String  @db.VarChar(255)
  shortDescription String? @db.VarChar(500)
  description      String? @db.Text
  metaTitle        String? @db.VarChar(255)
  metaDescription  String? @db.VarChar(500)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([locale, name])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String  @db.VarChar(512)
  alt       String? @db.VarChar(255)
  width     Int?
  height    Int?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductCategory {
  productId  Int
  categoryId Int
  isPrimary  Boolean @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

/// One row per locale, so the admin edits specs in the language they are in.
model ProductSpec {
  id        Int    @id @default(autoincrement())
  productId Int
  locale    String @db.VarChar(5)
  name      String @db.VarChar(191)
  value     String @db.VarChar(500)
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, locale, sortOrder])
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  PRE_ORDER
  ON_ORDER
}

// ─── Customers & auth ────────────────────────────────────────────────────────

model Customer {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  firstName    String   @db.VarChar(120)
  lastName     String?  @db.VarChar(120)
  phone        String?  @db.VarChar(40)
  locale       String   @default("ru") @db.VarChar(5)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  wishlist  WishlistItem[]
  carts     Cart[]
}

model Address {
  id         Int     @id @default(autoincrement())
  customerId Int
  label      String? @db.VarChar(120)
  firstName  String  @db.VarChar(120)
  lastName   String? @db.VarChar(120)
  phone      String  @db.VarChar(40)
  country    String  @default("UZ") @db.VarChar(2)
  city       String  @db.VarChar(120)
  addressLine String @db.VarChar(500)
  postcode   String? @db.VarChar(20)
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  name         String    @db.VarChar(120)
  role         AdminRole @default(MANAGER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum AdminRole {
  ADMIN
  MANAGER
}

// ─── Cart & orders ───────────────────────────────────────────────────────────

model Cart {
  id         Int      @id @default(autoincrement())
  /// Anonymous carts are keyed by an httpOnly cookie token.
  token      String   @unique @db.VarChar(64)
  customerId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([customerId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id          Int           @id @default(autoincrement())
  orderNumber String        @unique @db.VarChar(32)
  customerId  Int?
  status      OrderStatus   @default(NEW)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)
  currency    String        @default("UZS") @db.VarChar(3)
  subtotal    Decimal       @default(0) @db.Decimal(14, 2)
  shippingCost Decimal      @default(0) @db.Decimal(14, 2)
  discount    Decimal       @default(0) @db.Decimal(14, 2)
  total       Decimal       @default(0) @db.Decimal(14, 2)
  locale      String        @default("ru") @db.VarChar(5)

  firstName   String  @db.VarChar(120)
  lastName    String? @db.VarChar(120)
  email       String? @db.VarChar(191)
  phone       String  @db.VarChar(40)
  country     String  @default("UZ") @db.VarChar(2)
  city        String? @db.VarChar(120)
  addressLine String? @db.VarChar(500)
  comment     String? @db.Text
  /// Set when the cart held at least one price-on-request item.
  needsQuote  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  history  OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([phone])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int?
  /// Denormalised so an order stays readable after the product changes.
  name      String  @db.VarChar(255)
  sku       String? @db.VarChar(120)
  image     String? @db.VarChar(512)
  price     Decimal @db.Decimal(14, 2)
  quantity  Int
  total     Decimal @db.Decimal(14, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  note      String?     @db.VarChar(500)
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD_ON_DELIVERY
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  customerId Int
  productId  Int
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model Review {
  id         Int      @id @default(autoincrement())
  productId  Int
  customerId Int?
  authorName String   @db.VarChar(120)
  rating     Int      @default(5)
  text       String   @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, isApproved])
}

/// Callback / "ask for a price" requests from the storefront.
model Lead {
  id        Int        @id @default(autoincrement())
  type      LeadType   @default(CALLBACK)
  name      String     @db.VarChar(120)
  phone     String     @db.VarChar(40)
  email     String?    @db.VarChar(191)
  message   String?    @db.Text
  productId Int?
  locale    String     @default("ru") @db.VarChar(5)
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

enum LeadType {
  CALLBACK
  PRICE_REQUEST
  CONTACT
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  SPAM
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Page {
  id        Int      @id @default(autoincrement())
  /// Stable machine key (about, delivery, privacy, terms…) used by the footer.
  key       String   @unique @db.VarChar(64)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PageTranslation[]
}

model PageTranslation {
  id              Int     @id @default(autoincrement())
  pageId          Int
  locale          String  @db.VarChar(5)
  title           String  @db.VarChar(255)
  slug            String  @db.VarChar(255)
  content         String? @db.LongText
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.VarChar(500)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@unique([locale, slug])
}

model Post {
  id          Int       @id @default(autoincrement())
  image       String?   @db.VarChar(512)
  isActive    Boolean   @default(true)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  translations PostTranslation[]

  @@index([isActive, publishedAt])
}

model PostTranslation {
  id              Int     @id @default(autoincrement())
  postId          Int
  locale          String  @db.VarChar(5)
  title           String  @db.VarChar(255)
  slug            String  @db.VarChar(255)
  excerpt         String? @db.VarChar(500)
  content         String? @db.LongText
  metaTitle       String? @db.VarChar(255)
  metaDescription String? @db.VarChar(500)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@unique([locale, slug])
}

model Slide {
  id          Int      @id @default(autoincrement())
  image       String   @db.VarChar(512)
  mobileImage String?  @db.VarChar(512)
  link        String?  @db.VarChar(512)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  translations SlideTranslation[]

  @@index([isActive, sortOrder])
}

model SlideTranslation {
  id         Int     @id @default(autoincrement())
  slideId    Int
  locale     String  @db.VarChar(5)
  title      String? @db.VarChar(255)
  subtitle   String? @db.VarChar(255)
  buttonText String? @db.VarChar(120)

  slide Slide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([slideId, locale])
}

/// Free-form site settings (phones, socials, currency…), one JSON blob per key.
model Setting {
  key       String   @id @db.VarChar(120)
  value     Json
  updatedAt DateTime @updatedAt
}
